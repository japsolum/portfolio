rules_version = '2';

/* ---------------------------------------------------------------------------
 * Firestore security rules for the portfolio guest book.
 *
 * These run on Google's servers, not in the browser, so they hold even if
 * someone bypasses the site entirely and calls the API directly. This — not
 * the config keys in js/firebase-config.js — is what actually protects data.
 *
 * Paste into: Firebase console -> Firestore Database -> Rules -> Publish.
 * ownerUid() below is already set to James's uid.
 * ------------------------------------------------------------------------ */

service cloud.firestore {
  match /databases/{database}/documents {

    // Your uid — lets you delete anyone's message as the site owner.
    function ownerUid() {
      return 'Mkoaglf88TQkVYnq9pDgQBwiyzl1';
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.uid == ownerUid();
    }

    match /guestbook/{messageId} {

      // Anyone may read the guest book, signed in or not.
      allow read: if true;

      allow create: if signedIn()
        // You may only post as yourself.
        && request.resource.data.uid == request.auth.uid

        // Exactly these fields, nothing smuggled in alongside.
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'photoURL', 'text', 'createdAt'])

        // Real, sensibly sized message text.
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500

        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80

        && (request.resource.data.photoURL == null
            || (request.resource.data.photoURL is string
                && request.resource.data.photoURL.size() <= 500
                && request.resource.data.photoURL.matches('^https://.*')))

        // Timestamp must be the server's own clock, not a client-supplied one,
        // so nobody can backdate or pin a message to the top of the list.
        && request.resource.data.createdAt == request.time;

      // Messages are immutable once posted — no silent edits after the fact.
      allow update: if false;

      // Authors can remove their own message; the owner can remove any.
      allow delete: if isOwner()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }


    /* ---------------------------------------------------------------------
     * Game leaderboards — leaderboards/{game}/entries/{entryId}
     *
     * Deliberately open to write: high scores need no login. That makes
     * validation here the only guard, so the shape is pinned tightly and
     * every score must be physically achievable.
     *
     * Entries are append-only. Nobody can edit or delete another player's
     * score, so the board cannot be wiped or rewritten — the worst anyone
     * can do is add a bogus row, which you remove from the console. Because
     * scores below the top five are retained, deleting a cheat restores the
     * real sixth-place run instead of leaving a gap.
     * ------------------------------------------------------------------- */

    match /leaderboards/{game}/entries/{entryId} {

      function validShape() {
        return request.resource.data.keys().hasOnly(
                 ['initials', 'score', 'extra', 'sortKey', 'createdAt'])
          // Exactly three capital letters.
          && request.resource.data.initials is string
          && request.resource.data.initials.matches('^[A-Z]{3}$')
          && request.resource.data.score is int
          && request.resource.data.extra is int
          && request.resource.data.sortKey is int
          // Server clock only — no backdating a run to the top.
          && request.resource.data.createdAt == request.time;
      }

      // Memory Game: score is moves, extra is seconds. Eight moves is a
      // flawless game, so anything lower did not happen.
      function validMemory() {
        return game == 'memory-game'
          && request.resource.data.score >= 8
          && request.resource.data.score <= 500
          && request.resource.data.extra >= 1
          && request.resource.data.extra <= 86400
          && request.resource.data.sortKey ==
               request.resource.data.score * 100000 + request.resource.data.extra;
      }

      // Arcade Game: score is the win streak, extra is unused.
      function validArcade() {
        return game == 'arcade-game'
          && request.resource.data.score >= 1
          && request.resource.data.score <= 9999
          && request.resource.data.extra == 0
          && request.resource.data.sortKey == 1000000 - request.resource.data.score;
      }

      allow read: if true;
      allow create: if validShape() && (validMemory() || validArcade());
      allow update, delete: if isOwner();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
